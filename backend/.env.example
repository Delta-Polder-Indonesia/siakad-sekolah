# Database dengan connection pooling
DATABASE_URL=postgresql://username:password@localhost:5432/database_name?connection_limit=10&pool_timeout=10

# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# JWT Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your_refresh_token_secret_here_minimum_32_characters
JWT_REFRESH_EXPIRES_IN=7d

# Admin Panel Credentials (PPDB)
# Dibaca langsung oleh kode (src/config/env.ts): ADMIN_PASSWORD plaintext.
# Ganti dengan password kuat di production (min 8 karakter).
# Catatan: env.ts memblokir password lemah (admin/password/... ) di production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-admin-password-kuat-123

# Seed credentials (opsional, hanya dipakai `npm run prisma:seed`)
# - Non-produksi: seed memakai default demo guru123 / siswa123.
# - Production (NODE_ENV=production): seed DIBLOKIR jika env ini tidak diset
#   kuat (min 8 karakter). Wajibkan password kuat sebelum seed di prod.
SEED_TEACHER_PASSWORD=
SEED_STUDENT_PASSWORD=

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Backup configuration
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7

# Log Aggregation (Optional)
LOG_AGGREGATION_ENABLED=false
LOG_AGGREGATION_HOST=your-log-aggregation-service.com
LOG_AGGREGATION_PORT=443
LOG_AGGREGATION_PATH=/api/logs
LOG_AGGREGATION_API_KEY=your_api_key_here
LOG_BATCH_SIZE=10
LOG_FLUSH_INTERVAL=30000

# Alert Webhook (Optional)
ALERT_WEBHOOK_URL=https://your-monitoring-service.com/webhook/alerts

# Migration Testing (Optional)
TEST_DB_NAME=test_portal_siswa