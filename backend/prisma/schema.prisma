generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Connection pool configuration
  // connection_limit = 10
  // pool_timeout = 10
  // Connect timeout in seconds
  // connection_timeout = 10
}

model SchoolConfig {
  id                      String    @id @default(cuid())
  name                    String
  shortName               String
  type                    String
  npsn                    String?
  founded                 Int?
  accreditation           String?
  phone                   String?
  email                   String?
  website                 String?
  addressStreet           String?
  addressDistrict         String?
  addressCity             String?
  addressProvince         String?
  addressZip              String?
  mapsEmbedUrl            String?
  mapsDirectUrl           String?
  logoUrl                 String?
  profilePdfUrl           String?
  heroImageUrl            String?
  instagram               String?
  youtube                 String?
  facebook                String?
  weekdayLabel            String    @default("Senin - Jumat")
  weekdayHours            String    @default("07:00 - 15:30")
  weekendLabel            String    @default("Sabtu - Minggu")
  weekendHours            String    @default("Tutup")
  statStudents            String    @default("0")
  statTeachers            String    @default("0")
  statAchievements        String    @default("0")
  statAccreditation       String    @default("A")
  guestAccessCode         String    @default("TAMU2026")
  ppdbYear                String    @default("2026")
  ppdbIsOpen              Boolean   @default(false)
  ppdbRegistrationUrl     String?
  ppdbQuota               Int       @default(0)
  ppdbOpenDate            DateTime?
  ppdbCloseDate           DateTime?
  featureContactForm      Boolean   @default(true)
  featurePpdb             Boolean   @default(true)
  featureLibrary          Boolean   @default(true)
  featureOnlineAssignment Boolean   @default(true)
  featureReportCard       Boolean   @default(true)
  featureBilling          Boolean   @default(true)
  featureElearning        Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model ClassRoom {
  id                  String              @id @default(cuid())
  code                String              @unique
  name                String
  grade               String
  teacherId           String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  homeroomTeacher     Teacher?            @relation("HomeroomTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  globalAnnouncements Announcement[]
  attendances         Attendance[]
  announcements       ClassAnnouncement[]
  teachers            ClassRoomTeacher[]
  rosters             ClassRoster[]
  assignments         OnlineAssignment[]
  reportCards         ReportCard[]
  students            Student[]

  @@index([teacherId])
}

model Teacher {
  id              String              @id @default(cuid())
  name            String
  nip             String              @unique
  passwordHash    String
  subject         String
  email           String?
  phone           String?
  whatsapp        String?
  avatarUrl       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  attendances     Attendance[]
  classes         ClassRoomTeacher[]
  homeroomClasses ClassRoom[]         @relation("HomeroomTeacher")
  lessonNotes     TeacherLessonNote[]

  @@index([name]) // untuk search guru
  @@index([subject]) // untuk filtering berdasarkan mata pelajaran
  @@index([email]) // untuk lookup by email
}

model Student {
  id             String                 @id @default(cuid())
  name           String
  nis            String                 @unique
  passwordHash   String
  gender         String?
  classId        String
  avatarUrl      String?
  email          String?
  phone          String?
  address        String?
  guardianName   String?
  guardianPhone  String?
  guardianPasswordHash String? // login Wali Siswa (bcrypt); null = wali belum punya akun
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  submissions    AssignmentSubmission[]
  attendances    Attendance[]
  billings       Billing[]
  libraryLoans   LibraryTransaction[]
  reportCards    ReportCard[]
  classRoom      ClassRoom              @relation(fields: [classId], references: [id])
  classMutations StudentClassMutation[]
  suratIzin      SuratIzin[]

  @@index([classId])
  @@index([name]) // untuk search siswa
  @@index([gender]) // untuk filtering
  @@index([nis]) // untuk lookup by NIS
}

model ClassRoomTeacher {
  classRoomId String
  teacherId   String
  isHomeroom  Boolean   @default(false)
  classRoom   ClassRoom @relation(fields: [classRoomId], references: [id], onDelete: Cascade)
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([classRoomId, teacherId])
  @@index([teacherId])
}

model Attendance {
  id        String           @id @default(cuid())
  date      DateTime
  status    String
  note      String?
  studentId String
  teacherId String
  classId   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  classRoom ClassRoom        @relation(fields: [classId], references: [id])
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher   Teacher          @relation(fields: [teacherId], references: [id])

  @@unique([studentId, date])
  @@index([date])
  @@index([studentId, date])
  @@index([classId, date])
  @@index([status]) // untuk filtering berdasarkan status
  @@index([studentId, status]) // untuk query siswa berdasarkan status
}

model Announcement {
  id        String     @id @default(cuid())
  title     String
  content   String
  imageUrl  String?
  classId   String?
  createdBy String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  classRoom ClassRoom? @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

model ClassAnnouncement {
  id        String    @id @default(cuid())
  classId   String
  title     String
  content   String
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

model ClassRoster {
  id          String    @id @default(cuid())
  classId     String
  subject     String
  dayOfWeek   Int
  startTime   String
  endTime     String
  room        String?
  teacherName String
  updatedBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  classRoom   ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

model OnlineAssignment {
  id          String                 @id @default(cuid())
  classId     String
  title       String
  description String?
  content     Json?                  // Konten kaya frontend (summary, books, videos, attachments, exercises)
  dueDate     DateTime
  createdBy   String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  submissions AssignmentSubmission[]
  classRoom   ClassRoom              @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

model AssignmentSubmission {
  id             String           @id @default(cuid())
  assignmentId   String
  studentId      String
  answerText     String?
  attachmentUrl  String?
  attachmentName String?
  grade          Float?
  feedback       String?
  submittedAt    DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  assignment     OnlineAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
}

model ReportCard {
  id           String    @id @default(cuid())
  studentId    String
  classId      String
  academicYear String
  semester     String
  subject      String
  dailyScore   Float?
  assignScore  Float?
  midScore     Float?
  finalScore   Float?
  totalScore   Float?
  grade        String?
  predikat     String?
  teacherNote  String?
  inputBy      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  classRoom    ClassRoom @relation(fields: [classId], references: [id])
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, academicYear, semester, subject])
  @@index([studentId])
  @@index([classId])
  @@index([academicYear, semester]) // untuk filtering tahun ajaran
  @@index([subject]) // untuk filtering mata pelajaran
  @@index([grade]) // untuk filtering berdasarkan nilai
}

model BillingConfig {
  id            String   @id @default(cuid())
  monthlyAmount Int
  dueDay        Int
  updatedBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Billing {
  id            String    @id @default(cuid())
  studentId     String
  year          Int
  month         Int
  amount        Int
  dueDate       DateTime
  isPaid        Boolean   @default(false)
  paymentMethod String?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, year, month])
  @@index([studentId])
  @@index([isPaid])
}

model SuratIzin {
  id             String          @id @default(cuid())
  studentId      String
  classId        String
  type           String
  subject        String
  message        String
  letterDate     DateTime
  startDate      DateTime?
  endDate        DateTime?
  status         String         @default("MENUNGGU")
  attachmentUrl  String?
  attachmentName String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([classId])
  @@index([status])
}

model Book {
  id           String               @id @default(cuid())
  isbn         String?              @unique
  title        String
  author       String
  category     String
  publisher    String
  rack         String
  stock        Int                  @default(0)
  available    Int                  @default(0)
  description  String?
  coverUrl     String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transactions LibraryTransaction[]

  @@index([category])
  @@index([title])
}

model LibraryMember {
  id           String               @id @default(cuid())
  name         String
  memberType   String
  nis          String?
  className    String?
  joinedAt     DateTime             @default(now())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transactions LibraryTransaction[]
}

model LibraryTransaction {
  id         String                   @id @default(cuid())
  bookId     String
  memberId   String
  studentId  String?
  borrowDate DateTime
  dueDate    DateTime
  returnDate DateTime?
  status     String @default("MENUNGGU")
  note       String?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  book       Book                     @relation(fields: [bookId], references: [id])
  member     LibraryMember            @relation(fields: [memberId], references: [id])
  student    Student?                 @relation(fields: [studentId], references: [id])

  @@index([bookId])
  @@index([memberId])
  @@index([status])
}

model PPDBApplication {
  id             String             @id @default(cuid())
  registrationNo String             @unique
  status         String         @default("PENDING")
  fullName       String
  nisn           String
  nik            String
  birthPlace     String
  birthDate      DateTime
  gender         String
  religion       String
  address        String
  phone          String
  whatsapp       String?
  email          String
  previousSchool String
  previousNpsn   String?
  majorId        String?
  pathway        String
  fatherName     String?
  motherName     String?
  guardianName   String?
  guardianPhone  String?
  adminNotes     String?
  verifiedBy     String?
  verifiedAt     DateTime?
  submittedAt    DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  auditLogs      PPDBAuditLog[]
  documents      PPDBDocument[]
  notifications  PPDBNotification[]

  @@index([status])
  @@index([registrationNo])
}

model PPDBDocument {
  id            String          @id @default(cuid())
  applicationId String
  docKey        String
  fileUrl       String
  fileName      String
  validation    String          @default("PENDING")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  application   PPDBApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, docKey])
  @@index([applicationId])
}

model PPDBAuditLog {
  id            String           @id @default(cuid())
  applicationId String?
  action        String
  actor         String
  metadata      Json?
  occurredAt    DateTime         @default(now())
  application   PPDBApplication? @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
  @@index([occurredAt])
}

model PPDBNotification {
  id            String          @id @default(cuid())
  applicationId String
  type          String
  message       String
  isRead        Boolean         @default(false)
  createdAt     DateTime        @default(now())
  application   PPDBApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([isRead])
}

model StudentClassMutation {
  id          String   @id @default(cuid())
  studentId   String
  fromClassId String
  toClassId   String
  note        String?
  movedAt     DateTime @default(now())
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model TeacherLessonNote {
  id        String   @id @default(cuid())
  teacherId String
  classId   String
  subject   String
  date      DateTime
  materi    String
  hasPr     Boolean  @default(false)
  prDetail  String?
  note      String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId, subject, date])
  @@index([teacherId, classId])
}

model Like {
  id        Int      @id @default(autoincrement())
  programId String
  ip        String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, ip]) // 1 IP hanya bisa like 1x per program
  @@index([programId])
}

model Feedback {
  id          String   @id @default(cuid())
  name        String
  email       String?
  role        String   @default("guest")
  category    String   @default("saran")
  subject     String
  message     String
  priority    String   @default("sedang")
  status      String   @default("pending")
  rating      Int?
  avatar      String?
  adminNotes  String?
  processedAt DateTime?
  submittedAt DateTime @default(now())
  likes       Int      @default(0)
  likedBy     String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([priority])
  @@index([rating])
}

// Registry tunggal untuk semua token (access & refresh).
// Menggabungkan peran TokenBlacklist (revoked) dan ActiveSession (registrasi)
// dalam SATU tabel, sehingga validasi token di requireAuth cukup SATU query.
model SessionToken {
  id            String    @id @default(cuid())
  userId        String
  token         String    @unique
  tokenType     String    @default("access") // 'access' | 'refresh'
  expiresAt     DateTime
  revoked       Boolean   @default(false)
  revokedBy     String?
  revokedReason String?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revoked])
  @@index([token])
}
