From 47a735ad053a4d71bbb1f8b1c274023051c3fe9e Mon Sep 17 00:00:00 2001
From: Bintang Toba <anakkostbgusop@gmail.com>
Date: Tue, 11 Aug 2026 05:43:11 +0000
Subject: [PATCH 01/19] fix(backend): tambah migration Feedback & SessionToken
 yang hilang

- Model Feedback & SessionToken ada di schema.prisma tapi tidak punya
  CREATE TABLE di migration mana pun -> prisma migrate deploy di env baru
  akan error saat query kedua tabel.
- Perbaiki provider datasource sqlite -> postgresql agar konsisten dengan
  migration_lock.toml, seluruh migration SQL, dan dokumentasi.
- backend/.gitignore: pola '*.sql' global diam-diam meng-ignore folder
  prisma/migrations -> ganti jadi backups/*.sql

diff --git a/backend/.gitignore b/backend/.gitignore
index 2b24ee9..ac9539c 100644
--- a/backend/.gitignore
+++ b/backend/.gitignore
@@ -36,6 +36,6 @@ coverage/
 # Build
 *.tsbuildinfo
 
-# Backups
+# Backups (jangan pakai pola *.sql global — itu ikut meng-ignore migration Prisma!)
 backups/
-*.sql
\ No newline at end of file
+backups/*.sql
\ No newline at end of file
diff --git a/backend/prisma/migrations/20260811000000_add_feedback_sessiontoken/migration.sql b/backend/prisma/migrations/20260811000000_add_feedback_sessiontoken/migration.sql
new file mode 100644
index 0000000..c0b903b
--- /dev/null
+++ b/backend/prisma/migrations/20260811000000_add_feedback_sessiontoken/migration.sql
@@ -0,0 +1,58 @@
+-- CreateTable
+CREATE TABLE "Feedback" (
+    "id" TEXT NOT NULL,
+    "name" TEXT NOT NULL,
+    "email" TEXT,
+    "role" TEXT NOT NULL DEFAULT 'guest',
+    "category" TEXT NOT NULL DEFAULT 'saran',
+    "subject" TEXT NOT NULL,
+    "message" TEXT NOT NULL,
+    "priority" TEXT NOT NULL DEFAULT 'sedang',
+    "status" TEXT NOT NULL DEFAULT 'pending',
+    "rating" INTEGER,
+    "avatar" TEXT,
+    "adminNotes" TEXT,
+    "processedAt" TIMESTAMP(3),
+    "submittedAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "likes" INTEGER NOT NULL DEFAULT 0,
+    "likedBy" TEXT NOT NULL DEFAULT '[]',
+    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "updatedAt" TIMESTAMP(3) NOT NULL,
+
+    CONSTRAINT "Feedback_pkey" PRIMARY KEY ("id")
+);
+
+-- CreateTable
+CREATE TABLE "SessionToken" (
+    "id" TEXT NOT NULL,
+    "userId" TEXT NOT NULL,
+    "token" TEXT NOT NULL,
+    "tokenType" TEXT NOT NULL DEFAULT 'access',
+    "expiresAt" TIMESTAMP(3) NOT NULL,
+    "revoked" BOOLEAN NOT NULL DEFAULT false,
+    "revokedBy" TEXT,
+    "revokedReason" TEXT,
+    "revokedAt" TIMESTAMP(3),
+    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+
+    CONSTRAINT "SessionToken_pkey" PRIMARY KEY ("id")
+);
+
+-- CreateIndex
+CREATE INDEX "Feedback_category_idx" ON "Feedback"("category");
+-- CreateIndex
+CREATE INDEX "Feedback_status_idx" ON "Feedback"("status");
+-- CreateIndex
+CREATE INDEX "Feedback_priority_idx" ON "Feedback"("priority");
+-- CreateIndex
+CREATE INDEX "Feedback_rating_idx" ON "Feedback"("rating");
+-- CreateIndex
+CREATE UNIQUE INDEX "SessionToken_token_key" ON "SessionToken"("token");
+-- CreateIndex
+CREATE INDEX "SessionToken_userId_idx" ON "SessionToken"("userId");
+-- CreateIndex
+CREATE INDEX "SessionToken_expiresAt_idx" ON "SessionToken"("expiresAt");
+-- CreateIndex
+CREATE INDEX "SessionToken_revoked_idx" ON "SessionToken"("revoked");
+-- CreateIndex
+CREATE INDEX "SessionToken_token_idx" ON "SessionToken"("token");
diff --git a/backend/prisma/schema.prisma b/backend/prisma/schema.prisma
index 5f9549f..5f5bb35 100644
--- a/backend/prisma/schema.prisma
+++ b/backend/prisma/schema.prisma
@@ -3,7 +3,7 @@ generator client {
 }
 
 datasource db {
-  provider = "sqlite"
+  provider = "postgresql"
   url      = env("DATABASE_URL")
   // Connection pool configuration
   // connection_limit = 10
