From 21867af5ba772b0e96453381f57208f789b13eac Mon Sep 17 00:00:00 2001
From: Bintang Toba <anakkostbgusop@gmail.com>
Date: Tue, 11 Aug 2026 05:43:34 +0000
Subject: [PATCH 04/19] chore: bersihkan repo (vite.log, gitignore,
 env.example)

- vite.log terlanjur di-commit -> hapus dari git + ignore
- .gitignore: baris 'dokumentasi' meng-ignore folder yang sudah di-track;
  ganti jadi daftar file eksplisit. Tambah *.log, !.env.example.
- env.example: hapus Google Client ID asli & kredensial admin/admin,
  jadikan placeholder + lengkapi variabel backend (JWT, DB, dll).

diff --git a/.gitignore b/.gitignore
index df2f69a..190b86b 100644
--- a/.gitignore
+++ b/.gitignore
@@ -13,6 +13,8 @@ yarn-debug.log*
 yarn-error.log*
 pnpm-debug.log*
 dev-server.log
+vite.log
+*.log
 
 # OS / Editor
 .DS_Store
@@ -20,20 +22,21 @@ Thumbs.db
 .idea/
 .vscode/
 
-# Env files
+# Env files (jangan commit .env asli; env.example boleh di-track sebagai template)
 .env
 .env.*
-.env.example
+!.env.example
 
 # Playwright E2E test artifacts
 test-results/
 playwright-report/
 
-# md yang di sembunyikan
+# md lokal yang sengaja tidak di-commit (berisi info internal/rahasia)
+# CATATAN: jangan ignore seluruh folder (mis. "dokumentasi/") —
+# gunakan daftar nama file eksplisit di atas agar file lain tetap ter-track.
 PANDUAN_LOGIN.md
 SESSION_HISTORY.md
 STRUKTUR_PROYEK.md
 perencanaan.md
 catatan_eror.md
 AUDIT_REPORT.md
-dokumentasi
\ No newline at end of file
diff --git a/env.example b/env.example
index b6f023f..1b8e9fe 100644
--- a/env.example
+++ b/env.example
@@ -1,4 +1,39 @@
-# Environment Variables
-VITE_GOOGLE_CLIENT_ID=378551540056-4uh26d8e3ifgsdb1fvb2uqm0ee26nhbf.apps.googleusercontent.com
-VITE_ADMIN_USERNAME=admin
-VITE_ADMIN_PASSWORD=admin
+# ================= FRONTEND (Vite) =================
+# Base URL backend API. KOSONGKAN untuk mode mock (data lokal di browser).
+# Isi dengan URL backend asli, contoh: https://api.sekolah.com/api
+VITE_API_BASE_URL=
+
+# Google OAuth — ganti dengan Client ID dari Google Cloud Console
+VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
+
+# Kredensial admin PPDB (mode mock/local) — GANTI dengan nilai kuat!
+VITE_ADMIN_USERNAME=ganti-username-admin
+VITE_ADMIN_PASSWORD=ganti-password-admin-yang-kuat
+# PIN admin gerbang PPDB lokal (dibaca frontend mode mock). GANTI!
+VITE_ADMIN_PIN=ganti-pin-6-digit
+VITE_ADMIN_MAX_ATTEMPTS=5
+VITE_ADMIN_LOCK_MINUTES=15
+
+# ================= BACKEND (Express/Prisma) =================
+# PostgreSQL — ganti sesuai environment Anda
+DATABASE_URL=postgresql://username:password@localhost:5432/siakad_db
+
+# Secret JWT — generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
+JWT_SECRET=ganti-dengan-random-64-hex-char-minimal-32-karakter
+JWT_EXPIRES_IN=8h
+JWT_REFRESH_SECRET=ganti-dengan-random-64-hex-lain
+JWT_REFRESH_EXPIRES_IN=7d
+
+# Kredensial admin backend (PPDB API) — GANTI, minimal 8 karakter, jangan "admin"
+ADMIN_USERNAME=ganti-admin-username
+ADMIN_PASSWORD=ganti-admin-password-kuat-123
+
+# Origin frontend untuk CORS
+CLIENT_ORIGIN=http://localhost:5173
+
+# Opsional
+PORT=4000
+NODE_ENV=development
+GOOGLE_CLIENT_ID=
+BACKUP_DIR=./backups
+BACKUP_RETENTION_DAYS=7
-- 
2.47.3

