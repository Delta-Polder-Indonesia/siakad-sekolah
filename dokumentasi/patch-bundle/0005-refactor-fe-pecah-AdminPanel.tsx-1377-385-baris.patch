+
+  it('formatDate menghasilkan tanggal berbahasa Indonesia', () => {
+    const out = formatDate('2026-08-01T10:00:00.000Z');
+    expect(out).toMatch(/Agu/);
+    expect(out).toMatch(/2026/);
