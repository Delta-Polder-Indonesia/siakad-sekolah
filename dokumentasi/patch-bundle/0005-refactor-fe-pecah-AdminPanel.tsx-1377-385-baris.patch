+                    compact ? 'mt-0 text-[9px] tracking-widest' : 'mt-2 text-[10px]'
+                  )}
+                >
+                  Tidak ada pesan
+                </p>
+              </div>
+            )}
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
