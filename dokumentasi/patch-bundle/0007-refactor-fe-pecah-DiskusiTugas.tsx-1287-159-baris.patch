+              {isTeacher && (
+                <button
+                  type="button"
+                  onClick={onCreateGroup}
+                  title="Buat grup baru"
+                  className="inline-flex cursor-pointer items-center gap-0.5 text-[11px] font-bold text-black hover:text-black/60"
