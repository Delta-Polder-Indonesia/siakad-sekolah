+                  <Plus className="h-3.5 w-3.5" /> Grup
+                </button>
+              )}
+            </div>
+            <div className="min-h-0 flex-1 overflow-y-auto overscroll-contain">
+              {filteredGroups.length === 0 && (
+                <div className="px-3 py-6 text-center">
